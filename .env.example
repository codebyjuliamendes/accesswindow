# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker-compose)
POSTGRES_DB=accesswindow
POSTGRES_USER=accesswindow
POSTGRES_PASSWORD=change-me

# Application
APP_PORT=8080
# Zone that defines "today" for review dates (IANA id).
APP_TIME_ZONE=UTC
# Seed demo records into an empty database.
DEMO_SEED=false
# Days before the review date at which access shows as "review soon".
REVIEW_DUE_SOON_DAYS=14
# Latest review date accepted, in days from today.
REVIEW_MAX_HORIZON_DAYS=365

# Security
# Trusted identity header from an authenticating proxy (e.g. X-Auth-Request-Email). Empty = disabled.
ACTOR_HEADER=
# Send Strict-Transport-Security (only behind HTTPS).
HSTS_ENABLED=false
# Set to "framework" when behind a reverse proxy that sets X-Forwarded-* headers.
FORWARD_HEADERS_STRATEGY=none
RATE_LIMIT_WRITES=30
RATE_LIMIT_PERIOD=1m
MAX_PAYLOAD_BYTES=16384

# Logging: ecs (JSON, default), logstash, gelf, or empty for plain text.
LOG_FORMAT=ecs
